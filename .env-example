DB_USER=postgres
DB_PASS=postgres
DB_NAME=ms2ex_dev
DB_HOST=localhost

# Host ports for the Docker services; only affect the published ports,
# the app on the host always reaches the containers on 5432/6379
# DB_PORT=5432
# REDIS_PORT=6379
SERVER_ADDRESS=127.0.0.1

# Web port; defaults to 4000
# WEB_PORT=4000

# UGC data directory; defaults to priv/ugc
# UGC_DATA_DIR=/path/to/ugc_data

# Ecto query log level; defaults to false
# ECTO_LOG_LEVEL=debug
